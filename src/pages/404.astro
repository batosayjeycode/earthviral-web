---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | EarthViral" description="This page could not be found." noindex>
  <section class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="tabular text-sm text-cyan">404</p>
    <h1 class="mt-3 text-3xl font-bold text-white">This signal went quiet</h1>
    <p class="mt-3 text-ink-muted">The page you were looking for doesn't exist or has moved.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg border border-cyan/40 px-4 py-2 text-sm font-semibold text-cyan hover:bg-cyan/10"
    >
      Back to the world map
    </a>
  </section>
</BaseLayout>
