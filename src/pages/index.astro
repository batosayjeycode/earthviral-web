---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapHero from '../components/map/MapHero.astro';
import CountryDrawer from '../components/drawer/CountryDrawer.tsx';
import JsonLd from '../components/seo/JsonLd.astro';
import { homeGraph } from '../lib/structuredData.ts';
import NewsCard from '../components/news/NewsCard.astro';
import { batchMeta, getClusters, getCountries, getDigestDays } from '../lib/data.ts';
import { CATEGORIES, REGIONS, flagEmoji } from '../lib/taxonomy.ts';
import { formatDayShort } from '../lib/digest.ts';
import { isFallbackSummary } from '../lib/summary.ts';

// Stories still on the non-AI fallback show a source headline untranslated (Portuguese,
// Indonesian…) and no written summary, so the homepage lists only AI-written stories. The
// others stay on their country, category and topic hubs, and appear here once re-summarised.
const clusters = (await getClusters()).filter((c) => !isFallbackSummary(c));
const countries = await getCountries();
const ref = batchMeta.generatedAt;
const latestDigest = (await getDigestDays())[0];

// lg: feature card (2×2) + 2 beside it + two rows of 3 → 9 cards fill the 3-column grid exactly.
const trending = clusters.slice(0, 9);
// Newest stories only. The full archive (up to VAS.maxStoredStories) is reachable through the
// country, category and topic hubs and the sitemaps; rendering all of it here made the
// homepage ~1.9 MB with ~19k elements, which hurts Core Web Vitals and dilutes its links.
const LATEST_LIMIT = 48;
const latest = [...clusters]
  .sort((a, b) => Date.parse(b.firstDetectedAt) - Date.parse(a.firstDetectedAt))
  .slice(0, LATEST_LIMIT);
const latestCategories = CATEGORIES.filter((cat) =>
  latest.some((c) => c.categorySlug === cat.slug),
);

const regions = REGIONS.map((r) => {
  const inRegion = countries.filter((c) => c.region === r.name);
  return {
    ...r,
    countries: inRegion.slice(0, 4),
    activeCount: inRegion.filter((c) => c.intensityTier !== 'quiet').length,
    topicCount: inRegion.reduce((sum, c) => sum + c.topicCount, 0),
  };
});
---

<BaseLayout
  title="EarthViral — Global Viral News Map & Trending Topics by Country"
  description="See what is going viral in every country right now. An interactive world map of trending news, refreshed every 3 hours with AI summaries and links to original publishers."
>
  <JsonLd slot="head" data={homeGraph(clusters)} />
  <MapHero />
  <!-- Fixed-position panel; lives outside the hero's isolated stacking context so it layers above page content. -->
  <CountryDrawer client:idle />

  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Global trending: pre-rendered bento grid -->
    <section id="trending" aria-labelledby="trending-heading" class="pt-8 sm:pt-16">
      <div class="flex items-end justify-between gap-4">
        <h2 id="trending-heading" class="text-2xl font-bold text-ink-strong sm:text-3xl">
          <span aria-hidden="true">🔥</span> Global Trending Topics
        </h2>
        <p class="tabular hidden text-xs text-ink-faint sm:block">Ranked by Viral Activity Score</p>
      </div>
      {latestDigest && (
        <p class="mt-2 text-sm">
          <a class="font-semibold text-cyan hover:underline" href={latestDigest.path}>
            Top 10 of {formatDayShort(latestDigest.day)}: read the daily digest{' '}
            <span aria-hidden="true">→</span>
          </a>
        </p>
      )}
      <div class="mt-4 grid gap-3 sm:mt-6 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
        {trending.map((c, i) => (
          <NewsCard
            cluster={c}
            referenceIso={ref}
            variant={i === 0 ? 'feature' : 'default'}
            class={i === 0 ? 'md:col-span-2 lg:row-span-2' : ''}
          />
        ))}
      </div>
    </section>

    <!-- Latest: pre-rendered list with a client-side category filter (progressive enhancement) -->
    <section id="latest" aria-labelledby="latest-heading" class="pt-12 sm:pt-20">
      <h2 id="latest-heading" class="text-2xl font-bold text-ink-strong sm:text-3xl">
        <span aria-hidden="true">📰</span> Latest Viral News
      </h2>
      <div
        role="toolbar"
        aria-label="Filter by category"
        class="mt-5 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]"
        data-latest-filter
        hidden
      >
        <button type="button" data-filter="all" aria-pressed="true" class="ev-chip">
          All
        </button>
        {latestCategories.map((cat) => (
          <button type="button" data-filter={cat.slug} aria-pressed="false" class="ev-chip">
            {cat.shortName}
          </button>
        ))}
      </div>
      <div
        id="latest-list"
        class="mt-4 grid gap-3 sm:mt-6 sm:gap-4 sm:grid-cols-2 lg:grid-cols-3"
        data-latest-list
      >
        {latest.map((c) => (
          <NewsCard cluster={c} referenceIso={ref} />
        ))}
      </div>
      {/* Phones only: the list starts at PHONE_LIMIT cards (all cards stay in the HTML). */}
      <button
        type="button"
        aria-controls="latest-list"
        class="mt-4 w-full rounded-xl border border-line py-3 text-sm font-semibold text-cyan hover:border-cyan/40 sm:hidden"
        data-latest-more
        hidden
      >
        Show more stories
      </button>
    </section>

    <!-- Regions: pre-rendered hub links -->
    <section id="regions" aria-labelledby="regions-heading" class="pt-12 sm:pt-20">
      <h2 id="regions-heading" class="text-2xl font-bold text-ink-strong sm:text-3xl">
        <span aria-hidden="true">🌏</span> Trending by Region
      </h2>
      <div class="mt-4 grid gap-3 sm:mt-6 sm:gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {regions.map((r) => (
          <article class="rounded-2xl border border-line bg-land/60 p-4 light:bg-land light:shadow-card sm:p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-lg font-semibold text-ink-strong">
                <a class="hover:text-cyan" href={`/region/${r.slug}/`}>
                  {r.name}
                </a>
              </h3>
              <p class="tabular text-xs text-ink-faint">
                {r.activeCount} active · {r.topicCount} topics
              </p>
            </div>
            {r.countries.length > 0 ? (
              <ul class="mt-3 grid gap-2 text-sm sm:mt-4">
                {r.countries.map((c) => (
                  <li class="flex items-center gap-2">
                    <span aria-hidden="true">{flagEmoji(c.code)}</span>
                    <a class="text-ink hover:text-cyan" href={`/country/${c.slug}/`}>
                      {c.name}
                    </a>
                    <span class="tier-badge ml-auto" data-tier={c.intensityTier}>
                      {c.viralScore}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-sm text-ink-faint">No viral activity in this batch.</p>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Every country hub one click from home (each hub links its full story archive). -->
    <nav aria-labelledby="countries-heading" class="pt-10 sm:pt-16">
      <h2 id="countries-heading" class="text-2xl font-bold text-ink-strong sm:text-3xl">
        <span aria-hidden="true">🗺️</span> All Countries
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm sm:mt-6">
        {[...countries]
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((c) => (
            <li>
              <a
                class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-ink-muted hover:border-cyan/40 hover:text-ink-strong"
                href={`/country/${c.slug}/`}
              >
                <span aria-hidden="true">{flagEmoji(c.code)}</span>
                {c.name}
              </a>
            </li>
          ))}
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .ev-chip {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    transition:
      color 150ms,
      border-color 150ms,
      background-color 150ms;
  }
  .ev-chip:hover {
    color: var(--color-ink-strong);
  }
  /* Phones: cards past the limit wait behind "Show more" (set by the script below). */
  @media (width < 40rem) {
    /* :global — the cards are NewsCard elements, outside this page's scoped styles. */
    :global([data-latest-list][data-collapsed] > [data-more]) {
      display: none;
    }
  }
  .ev-chip[aria-pressed='true'] {
    color: var(--color-cyan);
    border-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
    background: color-mix(in srgb, var(--color-cyan) 8%, transparent);
  }
</style>

<script>
  // Instant category filter for the pre-rendered "Latest" list, and on phones a "Show more"
  // button after the first PHONE_LIMIT cards. Without JS every card stays visible.
  const PHONE_LIMIT = 12;
  const toolbar = document.querySelector<HTMLElement>('[data-latest-filter]');
  const list = document.querySelector<HTMLElement>('[data-latest-list]');
  const more = document.querySelector<HTMLButtonElement>('[data-latest-more]');
  if (toolbar && list && more) {
    toolbar.hidden = false;
    const cards = [...list.querySelectorAll<HTMLElement>('[data-category]')];
    let filter = 'all';

    // Mark the matching cards past the limit; CSS hides them on phones while collapsed.
    const update = () => {
      const shown = cards.filter((card) => {
        card.hidden = filter !== 'all' && card.dataset.category !== filter;
        return !card.hidden;
      });
      shown.forEach((card, i) => card.toggleAttribute('data-more', i >= PHONE_LIMIT));
      const extra = Math.max(0, shown.length - PHONE_LIMIT);
      more.hidden = !list.hasAttribute('data-collapsed') || extra === 0;
      more.textContent = `Show ${extra} more ${extra === 1 ? 'story' : 'stories'}`;
    };

    list.setAttribute('data-collapsed', '');
    update();

    toolbar.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      filter = button.dataset.filter ?? 'all';
      for (const b of toolbar.querySelectorAll('button'))
        b.setAttribute('aria-pressed', String(b === button));
      update();
    });

    more.addEventListener('click', () => {
      const next = cards.find((card) => card.hasAttribute('data-more'));
      list.removeAttribute('data-collapsed');
      more.hidden = true;
      // Keep keyboard and screen-reader users in place: focus the first newly shown story.
      next?.querySelector<HTMLAnchorElement>('h3 a')?.focus();
    });
  }
</script>
