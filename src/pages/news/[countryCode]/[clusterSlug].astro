---
/**
 * Static Viral Story Page (plan FR-07, §9.1). Zero client JS: everything — summary,
 * signal breakdown, locator globe, sources and the internal link graph — is pre-rendered.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import InternalLinkPills from '../../../components/seo/InternalLinkPills.astro';
import RelatedStories from '../../../components/news/RelatedStories.astro';
import SourceAttributionList from '../../../components/news/SourceAttributionList.astro';
import SignalBreakdown from '../../../components/news/SignalBreakdown.astro';
import LocatorGlobe from '../../../components/map/LocatorGlobe.astro';
import AdSlot from '../../../components/ads/AdSlot.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { newsArticleGraph } from '../../../lib/structuredData.ts';
import {
  batchMeta,
  getClusters,
  getCountries,
  getTopics,
  resolveClusters,
} from '../../../lib/data.ts';
import { categoryBySlug, flagEmoji } from '../../../lib/taxonomy.ts';
import { formatDateWib, formatTimeWib } from '../../../lib/format.ts';
import { linkifyFirstMentions } from '../../../lib/linkify.ts';
import type { ViralClusterStaticRecord } from '../../../lib/types.ts';

export const getStaticPaths = (async () => {
  const clusters = await getClusters();
  return clusters.map((cluster) => ({
    params: { countryCode: cluster.countryCode.toLowerCase(), clusterSlug: cluster.slug },
    props: { cluster },
  }));
}) satisfies GetStaticPaths;

interface Props {
  cluster: ViralClusterStaticRecord;
}

const { cluster: c } = Astro.props;
const [clusters, countries, topics] = await Promise.all([
  getClusters(),
  getCountries(),
  getTopics(),
]);
const country = countries.find((x) => x.code === c.countryCode)!;
const category = categoryBySlug(c.categorySlug)!;

const trendingInCountry = clusters
  .filter((x) => x.countryCode === c.countryCode && x !== c)
  .slice(0, 5);
const relatedInCategory = await resolveClusters(c.relatedInCategorySlugs);
const relatedInCountry = await resolveClusters(c.relatedInCountrySlugs, c.countryCode);
const relatedInCountryExtra = relatedInCountry.filter((x) => !trendingInCountry.includes(x));

const contextHtml = linkifyFirstMentions(c.aiContextParagraph, [
  ...countries
    .filter((x) => x.code !== c.countryCode)
    .map((x) => ({ term: x.name, href: `/country/${x.slug}/` })),
  ...topics.map((t) => ({ term: t.name, href: `/topic/${t.slug}/` })),
]);

const title = `${c.headline} — Viral in ${c.countryName} (Score: ${c.viralScore}/100) | EarthViral`;
const countryCategoryHref = `/country/${c.countrySlug}/${c.categorySlug}/`;
const jsonLd = newsArticleGraph(c, [
  { name: c.countryName, path: `/country/${c.countrySlug}/` },
  { name: category.name, path: countryCategoryHref },
  { name: c.headline },
]);
---

<BaseLayout
  title={title}
  description={c.metaDescription}
  ogType="article"
  ogImage={`/og/${c.id}.png`}
>
  <Fragment slot="head">
    <JsonLd data={jsonLd} />
    <meta property="article:published_time" content={c.firstDetectedAt} />
    <meta property="article:modified_time" content={c.lastUpdatedBatchAt} />
    <meta property="article:section" content={c.categoryName} />
    {c.entityTags.map((t) => (
      <meta property="article:tag" content={t.name} />
    ))}
  </Fragment>

  <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6">
    <Breadcrumbs
      items={[
        { name: c.countryName, href: `/country/${c.countrySlug}/` },
        { name: category.name, href: countryCategoryHref },
        { name: c.headline },
      ]}
    />

    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px]">
      <article
        data-pagefind-body
        data-pagefind-meta={`country:${c.countryName}, score:${c.viralScore}/100`}
      >
        <header>
          <div class="flex flex-wrap items-center gap-2 text-sm" data-pagefind-ignore>
            <a
              href={`/category/${c.categorySlug}/`}
              class="rounded-full border border-line px-2.5 py-0.5 text-ink-muted hover:text-cyan"
            >
              {c.categoryName}
            </a>
            <a href={`/country/${c.countrySlug}/`} class="text-ink-muted hover:text-cyan">
              <span aria-hidden="true">{flagEmoji(c.countryCode)}</span>
              {c.countryName}
            </a>
            <span class="tier-badge" data-tier={c.intensityTier}>
              <span aria-hidden="true">🔥</span>
              {c.viralScore}
              <span class="sr-only"> out of 100 viral activity score</span>
            </span>
          </div>
          <h1 class="mt-4 text-3xl leading-tight font-bold text-white sm:text-4xl">{c.headline}</h1>
          <p class="mt-4 text-lg leading-relaxed text-ink-muted">{c.whyItIsViral}</p>
          <p class="tabular mt-4 text-xs text-ink-faint" data-pagefind-ignore>
            First detected{' '}
            <time datetime={c.firstDetectedAt}>
              {formatDateWib(c.firstDetectedAt)} · {formatTimeWib(c.firstDetectedAt)}
            </time>
            · Updated in batch{' '}
            <time datetime={c.lastUpdatedBatchAt}>{formatTimeWib(c.lastUpdatedBatchAt)}</time>
          </p>
        </header>

        <section
          aria-labelledby="summary-heading"
          class="mt-8 rounded-2xl border border-cyan/20 bg-cyan/[0.03] p-6"
        >
          <h2
            id="summary-heading"
            class="text-xs font-semibold tracking-widest text-cyan uppercase"
          >
            Executive AI summary
          </h2>
          <ul class="mt-4 grid gap-3">
            {c.aiSummaryBullets.map((b) => (
              <li class="flex gap-3 text-ink">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-cyan" aria-hidden="true" />
                {b}
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="context-heading" class="mt-10">
          <h2 id="context-heading" class="font-display text-xl font-semibold text-white">
            Context: why it’s trending
          </h2>
          <p class="ev-prose mt-3 leading-relaxed text-ink" set:html={contextHtml} />
        </section>

        <div class="mt-10">
          <SourceAttributionList sources={c.sources} />
        </div>

        {c.entityTags.length > 0 && (
          <div class="mt-10">
            <h2 class="text-xs font-semibold tracking-widest text-ink-faint uppercase">
              Related topics
            </h2>
            <div class="mt-3">
              <InternalLinkPills tags={c.entityTags} label="Related topics" />
            </div>
          </div>
        )}

        <p class="mt-10 text-xs leading-relaxed text-ink-faint">
          This page is an AI-assisted summary of reporting by the publishers listed above, generated
          in the {formatTimeWib(batchMeta.generatedAt)} batch. It is refreshed every 3 hours while
          the story remains active.
        </p>
      </article>

      <aside class="grid content-start gap-6" aria-label="Story context">
        <div class="rounded-2xl border border-line bg-land/40 p-5 text-center">
          <LocatorGlobe
            isoNumeric={country.isoNumeric}
            centroid={country.centroid}
            tier={country.intensityTier}
            label={`Map locating ${country.name}`}
          />
          <p class="mt-3 text-sm text-ink-muted">
            {country.name} viral pulse
            <span class="tier-badge ml-1" data-tier={country.intensityTier}>
              {country.viralScore}/100
            </span>
          </p>
          <a href="/#map" class="mt-3 inline-block text-sm font-semibold text-cyan hover:underline">
            Explore the full live world map <span aria-hidden="true">→</span>
          </a>
        </div>

        <SignalBreakdown cluster={c} />

        <AdSlot placement="story" />

        <RelatedStories
          title={`Trending now in ${c.countryName}`}
          clusters={trendingInCountry}
          show="category"
          moreHref={`/country/${c.countrySlug}/`}
          moreLabel={`All ${c.countryName} stories`}
        />
      </aside>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      <RelatedStories
        title={`More viral in ${category.name}`}
        clusters={relatedInCategory}
        show="country"
        moreHref={`/category/${c.categorySlug}/`}
        moreLabel={`All ${category.name} stories worldwide`}
      />
      <RelatedStories
        title={`Related in ${c.countryName}`}
        clusters={relatedInCountryExtra}
        show="category"
        moreHref={countryCategoryHref}
        moreLabel={`${category.name} in ${c.countryName}`}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .ev-prose :global(a) {
    color: var(--color-cyan);
    text-decoration: underline;
    text-decoration-color: rgb(0 240 255 / 0.35);
    text-underline-offset: 3px;
  }
  .ev-prose :global(a:hover) {
    text-decoration-color: currentColor;
  }
</style>
