---
/**
 * Entity tag pills (plan §9.5 item 4). Tags with a topic page link to /topic/[tag-slug]/;
 * the rest (fewer than MIN_TOPIC_STORIES stories) render as plain text.
 */
import { getTopics } from '../../lib/data.ts';

interface Props {
  tags: Array<{ name: string; slug: string }>;
  label?: string;
}

const { tags, label = 'Topics' } = Astro.props;
const withPage = new Set((await getTopics()).map((t) => t.slug));
const pill =
  'inline-block rounded-full border border-line bg-land/60 px-3 py-1 text-sm text-ink-muted light:bg-land';
---

{tags.length > 0 && (
  <nav aria-label={label}>
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          {withPage.has(tag.slug) ? (
            <a href={`/topic/${tag.slug}/`} class={`${pill} hover:border-cyan/40 hover:text-cyan`}>
              #{tag.name.replace(/\s+/g, '')}
            </a>
          ) : (
            <span class={pill}>#{tag.name.replace(/\s+/g, '')}</span>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
