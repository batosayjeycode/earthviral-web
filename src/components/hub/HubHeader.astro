---
import Breadcrumbs, { type Crumb } from '../seo/Breadcrumbs.astro';

export interface HubStat {
  label: string;
  value: string | number;
}

interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  intro: string;
  stats?: HubStat[];
}

const { crumbs, eyebrow, title, intro, stats = [] } = Astro.props;
---

<header class="ev-hub-hero border-b border-line">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 pt-6 pb-10 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div>
      <Breadcrumbs items={crumbs} />
      {eyebrow && (
        <p class="mt-6 inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-cyan uppercase">
          <span class="h-px w-6 bg-cyan" aria-hidden="true" />
          {eyebrow}
        </p>
      )}
      <h1
        data-pagefind-meta="title"
        class:list={[
          'text-3xl leading-tight font-bold text-ink-strong sm:text-4xl',
          eyebrow ? 'mt-2' : 'mt-6',
        ]}
      >
        <slot name="title-prefix" />
        {title}
      </h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-pretty text-ink-muted">{intro}</p>
      {stats.length > 0 && (
        <dl class="mt-6 flex flex-wrap gap-3">
          {stats.map((s) => (
            <div class="min-w-32 flex-1 rounded-xl border border-line bg-land/50 px-4 py-3 light:bg-land light:shadow-card sm:flex-none">
              <dt class="text-xs text-ink-muted">{s.label}</dt>
              <dd class="tabular mt-1 text-lg font-semibold text-ink-strong">{s.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
    <slot name="aside" />
  </div>
</header>
