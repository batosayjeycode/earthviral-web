---
import Breadcrumbs, { type Crumb } from '../seo/Breadcrumbs.astro';

export interface HubStat {
  label: string;
  value: string | number;
}

interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  intro: string;
  stats?: HubStat[];
}

const { crumbs, eyebrow, title, intro, stats = [] } = Astro.props;
---

<header class="border-b border-line bg-[radial-gradient(ellipse_at_top_left,#0b1a33_0%,transparent_60%)]">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 pt-6 pb-10 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div>
      <Breadcrumbs items={crumbs} />
      {eyebrow && (
        <p class="mt-6 text-xs font-semibold tracking-widest text-cyan uppercase">{eyebrow}</p>
      )}
      <h1
        data-pagefind-meta="title"
        class:list={[
          'text-3xl leading-tight font-bold text-white sm:text-4xl',
          eyebrow ? 'mt-2' : 'mt-6',
        ]}
      >
        <slot name="title-prefix" />
        {title}
      </h1>
      <p class="mt-3 max-w-2xl text-ink-muted">{intro}</p>
      {stats.length > 0 && (
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          {stats.map((s) => (
            <div>
              <dt class="text-xs text-ink-faint">{s.label}</dt>
              <dd class="tabular mt-0.5 text-lg font-semibold text-white">{s.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
    <slot name="aside" />
  </div>
</header>
