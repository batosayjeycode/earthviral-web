---
/** Labelled list of hub links (categories, countries, regions…) used across hub pages. */
export interface HubLink {
  name: string;
  href: string;
  meta?: string | number;
  current?: boolean;
  prefix?: string;
}

interface Props {
  title: string;
  links: HubLink[];
}

const { title, links } = Astro.props;
const id = `links-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

{links.length > 0 && (
  <nav aria-labelledby={id} data-pagefind-ignore>
    <h2 id={id} class="text-xs font-semibold tracking-widest text-ink-faint uppercase">
      {title}
    </h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={l.current ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm',
              l.current
                ? 'border-cyan/45 bg-cyan/10 text-cyan'
                : 'border-line text-ink-muted hover:border-cyan/40 hover:text-cyan',
            ]}
          >
            {l.prefix && <span aria-hidden="true">{l.prefix}</span>}
            {l.name}
            {l.meta !== undefined && <span class="tabular text-xs text-ink-faint">{l.meta}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
