---
/**
 * Social share bar for story pages.
 *
 * SEO / performance notes:
 * - Every network button is a plain `<a>` to the network's share intent, so sharing works with
 *   JavaScript disabled and no third-party SDK (tracking pixels, extra requests, layout shift)
 *   is ever loaded. Icons are inlined at build time from simple-icons — zero runtime cost.
 * - Links carry `rel="nofollow noopener noreferrer"`: crawlers don't follow share endpoints or
 *   spend crawl budget on them, and no link equity leaks to them.
 * - The shared URL is the canonical URL plus UTM tags, so social traffic is attributable in
 *   analytics while `<link rel="canonical">` / `og:url` keep all signals on one URL.
 * - The bar is `data-pagefind-ignore` so site search doesn't index "Share on WhatsApp".
 * - "Copy link" and the native share sheet (mobile) are progressive enhancements: they stay
 *   hidden until the small module script below has run.
 */
import { siFacebook, siReddit, siTelegram, siThreads, siWhatsapp, siX } from 'simple-icons';

interface Props {
  /** Canonical absolute URL of the story. */
  url: string;
  /** Headline used as the share text. */
  title: string;
  /** Visible label above the buttons. */
  heading?: string;
  /** Distinguishes multiple bars on one page (UTM content + element ids). */
  placement: 'top' | 'bottom';
}

const { url, title, heading = 'Share', placement } = Astro.props;

const tagged = (source: string) => {
  const u = new URL(url);
  u.searchParams.set('utm_source', source);
  u.searchParams.set('utm_medium', 'social');
  u.searchParams.set('utm_campaign', 'share');
  u.searchParams.set('utm_content', placement);
  return u.href;
};
const enc = encodeURIComponent;

const networks = [
  {
    name: 'WhatsApp',
    icon: siWhatsapp,
    color: '#25D366',
    href: `https://wa.me/?text=${enc(`${title} ${tagged('whatsapp')}`)}`,
  },
  {
    name: 'X',
    icon: siX,
    color: 'var(--color-ink-strong)',
    onBrand: 'var(--color-void)',
    href: `https://x.com/intent/post?text=${enc(title)}&url=${enc(tagged('x'))}`,
  },
  {
    name: 'Facebook',
    icon: siFacebook,
    color: '#0866FF',
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(tagged('facebook'))}`,
  },
  {
    name: 'Threads',
    secondary: true,
    icon: siThreads,
    color: 'var(--color-ink-strong)',
    onBrand: 'var(--color-void)',
    href: `https://www.threads.net/intent/post?text=${enc(`${title} ${tagged('threads')}`)}`,
  },
  {
    name: 'Telegram',
    secondary: true,
    icon: siTelegram,
    color: '#26A5E4',
    href: `https://t.me/share/url?url=${enc(tagged('telegram'))}&text=${enc(title)}`,
  },
  {
    name: 'Reddit',
    secondary: true,
    icon: siReddit,
    color: '#FF4500',
    href: `https://www.reddit.com/submit?url=${enc(tagged('reddit'))}&title=${enc(title)}`,
  },
];
const headingId = `share-heading-${placement}`;
---

<section
  class="share-bar"
  data-placement={placement}
  aria-labelledby={headingId}
  data-pagefind-ignore
  data-share
  data-share-url={tagged('copy')}
  data-share-native-url={tagged('native')}
  data-share-title={title}
>
  <h2 id={headingId} class="share-heading">
    {heading}
  </h2>
  <ul class="share-list" role="list">
    <li hidden data-share-native-item>
      <button type="button" class="share-primary" data-share-native>
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7" />
          <path d="M16 6l-4-4-4 4" />
          <path d="M12 2v13" />
        </svg>
        Share
      </button>
    </li>
    {networks.map((n) => (
      <li class:list={{ 'share-secondary': n.secondary }}>
        <a
          href={n.href}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="share-btn"
          style={`--brand: ${n.color}; --on-brand: ${n.onBrand ?? '#fff'}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d={n.icon.path} />
          </svg>
          <span class="share-tip" aria-hidden="true">
            {n.name}
          </span>
          <span class="sr-only">Share on {n.name} (opens in a new tab)</span>
        </a>
      </li>
    ))}
    <li hidden data-share-copy-item>
      <button
        type="button"
        class="share-btn"
        style="--brand: var(--color-cyan); --on-brand: var(--color-void)"
        data-share-copy
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
          <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
        </svg>
        <span class="share-tip" aria-hidden="true" data-share-copy-label>
          Copy link
        </span>
        <span class="sr-only">Copy link</span>
      </button>
    </li>
  </ul>
  <p class="sr-only" aria-live="polite" data-share-status></p>
</section>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const { shareUrl = '', shareNativeUrl = '', shareTitle = '' } = bar.dataset;
    const status = bar.querySelector<HTMLElement>('[data-share-status]')!;

    // Native share sheet (most phones): reaches every app the reader has, incl. Instagram/LINE.
    if (typeof navigator.share === 'function') {
      bar.querySelector<HTMLElement>('[data-share-native-item]')!.hidden = false;
      bar.dataset.native = '';
      bar.querySelector('[data-share-native]')!.addEventListener('click', () => {
        navigator.share({ title: shareTitle, url: shareNativeUrl }).catch(() => {
          /* dismissed by the reader */
        });
      });
    }

    if (navigator.clipboard) {
      bar.querySelector<HTMLElement>('[data-share-copy-item]')!.hidden = false;
      const button = bar.querySelector<HTMLElement>('[data-share-copy]')!;
      const label = bar.querySelector<HTMLElement>('[data-share-copy-label]')!;
      let reset: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(shareUrl);
          label.textContent = 'Copied!';
          status.textContent = 'Link copied to clipboard';
        } catch {
          label.textContent = 'Copy failed';
          status.textContent = 'Could not copy the link';
        }
        button.dataset.copied = '';
        clearTimeout(reset);
        reset = setTimeout(() => {
          label.textContent = 'Copy link';
          status.textContent = '';
          delete button.dataset.copied;
        }, 2000);
      });
    }
  }
</script>

<style>
  .share-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }
  /* Closing call to action: a light card so it reads as the end of the story. */
  .share-bar[data-placement='bottom'] {
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-cyan) 18%, transparent);
    background:
      linear-gradient(
        110deg,
        color-mix(in srgb, var(--color-cyan) 7%, transparent),
        color-mix(in srgb, var(--color-surge-hot) 8%, transparent)
      ),
      color-mix(in srgb, var(--color-land) 50%, transparent);
  }
  :global([data-theme='light']) .share-bar[data-placement='bottom'] {
    background-color: var(--color-land);
    box-shadow: var(--shadow-card);
  }

  .share-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .share-bar[data-placement='bottom'] .share-heading {
    flex: 1 1 14rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink-strong);
  }

  .share-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  /* Round icon buttons: brand-tinted at rest, filled with the brand colour on hover. */
  .share-btn {
    --brand: var(--color-cyan);
    --on-brand: #fff;
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brand) 28%, transparent);
    background: color-mix(in srgb, var(--brand) 9%, transparent);
    color: var(--brand);
    cursor: pointer;
    transition:
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .share-btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .share-btn:hover,
  .share-btn:focus-visible {
    transform: translateY(-2px) scale(1.06);
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-brand);
    box-shadow: 0 6px 18px -6px color-mix(in srgb, var(--brand) 75%, transparent);
  }
  .share-btn[data-copied] {
    --brand: var(--color-verified);
    --on-brand: #fff;
    background: var(--brand);
    color: var(--on-brand);
  }
  /* Day mode: bright brand colours (WhatsApp green, Telegram blue) wash out on white. */
  :global([data-theme='light']) .share-btn:not(:hover, :focus-visible, [data-copied]) {
    color: color-mix(in srgb, var(--brand) 75%, #000);
  }

  /* Name tooltip on hover / keyboard focus (and "Copied!" feedback). */
  .share-tip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    z-index: 10;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--color-ink-strong);
    color: var(--color-void);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .share-btn:hover .share-tip,
  .share-btn:focus-visible .share-tip,
  .share-btn[data-copied] .share-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Native share sheet (phones): the one labelled, gradient call to action. */
  .share-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.5rem;
    padding: 0 1rem;
    border-radius: 9999px;
    background: linear-gradient(110deg, var(--color-cyan), var(--color-surge-hot));
    color: var(--color-void);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 16px -6px color-mix(in srgb, var(--color-cyan) 70%, transparent);
    transition:
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.15s ease;
  }
  .share-primary svg {
    width: 1rem;
    height: 1rem;
  }
  .share-primary:hover,
  .share-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -6px color-mix(in srgb, var(--color-surge-hot) 75%, transparent);
  }

  /*
   * Phones with a native share sheet: it already reaches Telegram, Threads, Reddit and every
   * other app, so keep one tidy row (Share + WhatsApp, X, Facebook, copy link). Without it
   * all seven icons still fit one row at 320px+.
   */
  @media (max-width: 639px) {
    .share-bar[data-native] .share-secondary {
      display: none;
    }
    /* Label on its own line either way, so revealing the Share button never shifts layout. */
    .share-heading {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .share-btn,
    .share-primary,
    .share-tip {
      transition: none;
    }
    .share-btn:hover,
    .share-btn:focus-visible,
    .share-primary:hover,
    .share-primary:focus-visible {
      transform: none;
    }
  }
</style>
