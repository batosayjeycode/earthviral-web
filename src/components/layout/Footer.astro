---
import { CATEGORIES, REGIONS } from '../../lib/taxonomy.ts';
import { getCountries } from '../../lib/data.ts';

const topCountries = (await getCountries()).slice(0, 8);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-ocean">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-bold text-white">
        Earth<span class="text-cyan">Viral</span>
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        Global viral news intelligence, refreshed every 3 hours. Every story links to its original
        publishers.
      </p>
    </div>
    <nav aria-label="Categories">
      <h2 class="text-xs font-semibold tracking-widest text-ink-faint uppercase">Categories</h2>
      <ul class="mt-3 grid gap-1.5 text-sm">
        {CATEGORIES.map((c) => (
          <li>
            <a class="text-ink-muted hover:text-cyan" href={`/category/${c.slug}/`}>
              {c.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Top countries and regions">
      <h2 class="text-xs font-semibold tracking-widest text-ink-faint uppercase">Top Countries</h2>
      <ul class="mt-3 grid gap-1.5 text-sm">
        {topCountries.map((c) => (
          <li>
            <a class="text-ink-muted hover:text-cyan" href={`/country/${c.slug}/`}>
              {c.name}
            </a>
          </li>
        ))}
      </ul>
      <h2 class="mt-6 text-xs font-semibold tracking-widest text-ink-faint uppercase">Regions</h2>
      <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 text-sm">
        {REGIONS.map((r) => (
          <li>
            <a class="text-ink-muted hover:text-cyan" href={`/region/${r.slug}/`}>
              {r.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="About EarthViral">
      <h2 class="text-xs font-semibold tracking-widest text-ink-faint uppercase">EarthViral</h2>
      <ul class="mt-3 grid gap-1.5 text-sm">
        <li>
          <a class="text-ink-muted hover:text-cyan" href="/about/">
            About &amp; Methodology
          </a>
        </li>
        <li>
          <a class="text-ink-muted hover:text-cyan" href="/contact/">
            Contact
          </a>
        </li>
        <li>
          <a class="text-ink-muted hover:text-cyan" href="/privacy/">
            Privacy
          </a>
        </li>
        <li>
          <a class="text-ink-muted hover:text-cyan" href="/terms/">
            Terms
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <p class="border-t border-line py-6 text-center text-xs text-ink-faint">© {year} EarthViral</p>
</footer>
