---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface Props {
  title: string;
  pageTitle: string;
  description: string;
  updated?: string;
}

const { title, pageTitle, description, updated } = Astro.props;
---

<BaseLayout title={pageTitle} description={description}>
  <article class="ev-prose mx-auto max-w-3xl px-4 pt-6 pb-8 sm:px-6">
    <Breadcrumbs items={[{ name: title }]} />
    <h1 class="mt-6 text-3xl font-bold text-white sm:text-4xl">{title}</h1>
    {updated && <p class="tabular mt-2 text-xs text-ink-faint">Last updated {updated}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .ev-prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.375rem;
    font-weight: 600;
    color: white;
  }
  .ev-prose :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: white;
  }
  .ev-prose :global(p),
  .ev-prose :global(li) {
    line-height: 1.75;
    color: var(--color-ink);
  }
  .ev-prose :global(p) {
    margin-top: 1rem;
  }
  .ev-prose :global(ul),
  .ev-prose :global(ol) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.375rem;
  }
  .ev-prose :global(ul) {
    list-style: disc;
  }
  .ev-prose :global(ol) {
    list-style: decimal;
  }
  .ev-prose :global(a) {
    color: var(--color-cyan);
    text-decoration: underline;
    text-decoration-color: rgb(0 240 255 / 0.35);
    text-underline-offset: 3px;
  }
  .ev-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-cyan);
  }
  .ev-prose :global(table) {
    margin-top: 1rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .ev-prose :global(th),
  .ev-prose :global(td) {
    border-bottom: 1px solid var(--color-line);
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
  }
  .ev-prose :global(th) {
    color: var(--color-ink-muted);
    font-weight: 500;
  }
</style>
