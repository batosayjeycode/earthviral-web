---
import { getCountries } from '../../lib/data.ts';
import { GEO_KEY, GEO_TTL_MS, PICK_KEY } from '../../lib/edition.ts';
import { CATEGORIES } from '../../lib/taxonomy.ts';

// Countries with a hub page, for the edition button's geo swap: code → [slug, name].
const editions = Object.fromEntries(
  (await getCountries()).map((c) => [c.code, [c.slug, c.name]] as const),
);
---

<!-- relative z-10: dropdowns must layer above the telemetry strip that follows. -->
<header class="glass relative z-10 border-x-0 border-t-0">
  <nav aria-label="Primary" class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-ink-strong"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-6 text-cyan"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
        <path d="M3 12h18"></path>
        <circle cx="17" cy="7" r="1.6" fill="currentColor" stroke="none"></circle>
      </svg>
      Earth<span class="text-cyan">Viral</span>
    </a>

    <ul class="ml-4 hidden items-center gap-1 text-sm text-ink-muted md:flex">
      <li>
        <a class="rounded-md px-3 py-2 hover:bg-ink-strong/5 hover:text-ink-strong" href="/#map">
          Explore Map
        </a>
      </li>
      <li>
        <a
          class="rounded-md px-3 py-2 hover:bg-ink-strong/5 hover:text-ink-strong"
          href="/#trending"
        >
          Trending
        </a>
      </li>
      <!-- From lg only: at md the nav has no room for a fourth item (tablet overflow). -->
      <li class="hidden lg:list-item">
        <a class="rounded-md px-3 py-2 hover:bg-ink-strong/5 hover:text-ink-strong" href="/digest/">
          Daily Digest
        </a>
      </li>
      <li>
        <details class="group relative">
          <summary class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 hover:bg-ink-strong/5 hover:text-ink-strong [&::-webkit-details-marker]:hidden">
            Categories
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              class="size-4 transition group-open:rotate-180"
              fill="currentColor"
            >
              <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path>
            </svg>
          </summary>
          <ul class="absolute top-full left-0 mt-2 grid w-64 gap-0.5 rounded-xl border border-line bg-ocean/97 p-2 shadow-2xl backdrop-blur">
            {CATEGORIES.map((c) => (
              <li>
                <a
                  class="block rounded-md px-3 py-2 hover:bg-ink-strong/5 hover:text-ink-strong"
                  href={`/category/${c.slug}/`}
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <!-- Day/night toggle. Hidden without JS (it could not work); revealed before first paint. -->
      <button
        type="button"
        hidden
        data-theme-toggle
        aria-label="Switch to light theme"
        title="Switch to light theme"
        class="flex items-center rounded-lg border border-line p-1.5 text-ink-muted hover:border-cyan/40 hover:text-ink-strong"
      >
        <!-- Sun shows in dark mode (go light), moon in light mode (go dark). -->
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="ev-theme-sun size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="ev-theme-moon size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <script is:inline>
        (() => {
          const b = document.querySelector('[data-theme-toggle]');
          const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          b.setAttribute('aria-label', `Switch to ${next} theme`);
          b.title = `Switch to ${next} theme`;
          b.hidden = false;
        })();
      </script>
      <!-- Opens the Pagefind dialog when JS is ready; plain link to /search/ otherwise. -->
      <a
        href="/search/"
        data-search-trigger
        aria-keyshortcuts="Meta+K Control+K"
        class="flex items-center gap-2 rounded-lg border border-line px-2.5 py-1.5 text-sm text-ink-muted hover:border-cyan/40 hover:text-ink-strong sm:px-3"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="9" cy="9" r="6"></circle>
          <path d="m14 14 4 4"></path>
        </svg>
        <span class="sr-only sm:not-sr-only">Search</span>
        <kbd class="tabular hidden rounded border border-line px-1 text-xs lg:inline">⌘K</kbd>
      </a>
      <!-- Edition. The HTML always says Indonesia (what crawlers and no-JS visitors get). With JS,
           the script below shows the visitor's manual pick or detected country instead, and
           reveals the "change edition" menu, which is built in the browser so the crawlable
           HTML and its links stay the same. -->
      <div class="relative flex items-center gap-1" data-edition-root>
        <!-- If a saved edition will replace Indonesia, hide the link (global.css,
             [data-edition-pending]) until the restore script below has swapped it, so a paint
             in between (the parser can stall on any network chunk) never shows Indonesia. -->
        <script is:inline define:vars={{ GEO_KEY, PICK_KEY }}>
          try {
            if (localStorage.getItem(PICK_KEY) || localStorage.getItem(GEO_KEY))
              document.documentElement.setAttribute('data-edition-pending', '');
          } catch {
            /* storage blocked: nothing saved to restore */
          }
        </script>
        <a
          href="/country/indonesia/"
          data-edition
          data-current="ID"
          data-editions={JSON.stringify(editions)}
          class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-sm text-ink hover:border-cyan/40"
          aria-label="Indonesia edition"
        >
          <span aria-hidden="true" data-edition-flag>
            🇮🇩
          </span>
          <span class="hidden sm:inline" data-edition-name>
            Indonesia
          </span>
        </a>
        <button
          type="button"
          hidden
          data-edition-toggle
          aria-expanded="false"
          aria-controls="edition-menu"
          aria-label="Change edition"
          class="flex items-center rounded-lg border border-line px-1.5 py-1.5 text-ink-muted hover:border-cyan/40 hover:text-ink-strong"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="currentColor">
            <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path>
          </svg>
        </button>
        <!-- Restores the saved edition while the page is still parsing, before first paint, so
             Indonesia never flashes. Mirrors resolveEdition/readGeoCache in lib/edition.ts
             (manual pick → detected country cached < 1 day → keep the HTML default); the
             module script below then adds the menu and asks /api/geo when needed. Revealing
             the menu button here too keeps the header from shifting later. -->
        <script is:inline define:vars={{ GEO_KEY, PICK_KEY, GEO_TTL_MS }}>
          try {
            const a = document.querySelector('[data-edition]');
            document.querySelector('[data-edition-toggle]').hidden = false;
            const editions = JSON.parse(a.dataset.editions);
            const pick = localStorage.getItem(PICK_KEY);
            let geo = null;
            try {
              const cached = JSON.parse(localStorage.getItem(GEO_KEY));
              const age = Date.now() - cached.at;
              if (age >= 0 && age < GEO_TTL_MS) geo = cached.country;
            } catch {
              /* no usable geo cache */
            }
            const code = editions[pick] ? pick : editions[geo] ? geo : null;
            if (code) {
              a.dataset.current = code;
              a.href = `/country/${editions[code][0]}/`;
              a.setAttribute('aria-label', `${editions[code][1]} edition`);
              a.querySelector('[data-edition-flag]').textContent = String.fromCodePoint(
                ...[...code].map((ch) => 0x1f1a5 + ch.charCodeAt(0)),
              );
              a.querySelector('[data-edition-name]').textContent = editions[code][1];
            }
          } catch {
            /* storage blocked or markup changed: the module script still applies the edition */
          }
          document.documentElement.removeAttribute('data-edition-pending');
        </script>
        <div
          id="edition-menu"
          hidden
          data-edition-menu
          class="absolute top-full right-0 z-50 mt-2 w-64 rounded-xl border border-line bg-ocean/97 p-2 shadow-2xl backdrop-blur"
        >
          <p class="px-3 py-1.5 text-xs font-semibold tracking-widest text-ink-faint uppercase">
            Choose your edition
          </p>
          <button
            type="button"
            hidden
            data-edition-auto
            class="block w-full rounded-md px-3 py-2 text-left text-sm text-cyan hover:bg-ink-strong/5"
          >
            Use my location
          </button>
          <ul data-edition-list class="grid max-h-[60vh] gap-0.5 overflow-y-auto text-sm"></ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  :global([data-theme='light']) .ev-theme-sun,
  :global(:root:not([data-theme='light'])) .ev-theme-moon {
    display: none;
  }
</style>

<script>
  import { THEME_COLOR, THEME_KEY, type Theme } from '../../lib/theme.ts';

  // Day/night: night is the default; a click switches and saves the reader's pick.
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[data-theme-color]');
  const applyTheme = (theme: Theme) => {
    document.documentElement.dataset.theme = theme;
    if (themeMeta) themeMeta.content = THEME_COLOR[theme];
    const next = theme === 'light' ? 'dark' : 'light';
    themeToggle?.setAttribute('aria-label', `Switch to ${next} theme`);
    if (themeToggle) themeToggle.title = `Switch to ${next} theme`;
  };
  themeToggle?.addEventListener('click', () => {
    const theme: Theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      /* storage blocked: the pick lasts for this page only */
    }
    applyTheme(theme);
  });
</script>

<script>
  import {
    GEO_KEY,
    PICK_KEY,
    readGeoCache,
    resolveEdition,
    writeGeoCache,
    type Editions,
  } from '../../lib/edition.ts';
  import { flagEmoji } from '../../lib/taxonomy.ts';

  // Edition = manual pick → detected country → Indonesia (see lib/edition.ts). The detected
  // country comes from /api/geo (a Cloudflare Pages Function) and is cached in this visitor's
  // localStorage for a day, so later pages switch without a request. Failures (local preview,
  // offline, blocked) are not cached and leave the current edition.
  const link = document.querySelector<HTMLAnchorElement>('[data-edition]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-edition-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-edition-menu]');
  const auto = document.querySelector<HTMLButtonElement>('[data-edition-auto]');
  const list = document.querySelector<HTMLUListElement>('[data-edition-list]');

  const storage = {
    get(key: string) {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set(key: string, value: string | null) {
      try {
        if (value === null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
      } catch {
        /* storage blocked: the choice lasts for this page only */
      }
    },
  };

  if (link && toggle && menu && auto && list) {
    const editions = JSON.parse(link.dataset.editions ?? '{}') as Editions;
    let detected: string | null | undefined = readGeoCache(
      storage.get(GEO_KEY),
      Date.now(),
    )?.country;

    const show = () => {
      const code = resolveEdition(editions, storage.get(PICK_KEY), detected);
      const [slug, name] = editions[code]!;
      link.dataset.current = code;
      link.href = `/country/${slug}/`;
      link.setAttribute('aria-label', `${name} edition`);
      link.querySelector('[data-edition-flag]')!.textContent = flagEmoji(code);
      link.querySelector('[data-edition-name]')!.textContent = name;
      for (const b of list.querySelectorAll<HTMLButtonElement>('[data-code]'))
        b.setAttribute('aria-pressed', String(b.dataset.code === code));
      auto.hidden = !storage.get(PICK_KEY);
    };

    const detect = () =>
      fetch('/api/geo')
        .then((r) => (r.ok ? (r.json() as Promise<{ country: string | null }>) : null))
        .then((d) => {
          if (!d) return;
          detected = d.country;
          storage.set(GEO_KEY, writeGeoCache(d.country, Date.now()));
          show();
        })
        .catch(() => {});

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    // Menu: every edition, alphabetical. Picking one remembers it and opens that edition.
    const sorted = Object.entries(editions).sort((a, b) => a[1][1].localeCompare(b[1][1]));
    for (const [code, [, name]] of sorted) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.code = code;
      b.className =
        'flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-ink-muted hover:bg-ink-strong/5 hover:text-ink-strong aria-pressed:bg-ink-strong/5 aria-pressed:font-semibold aria-pressed:text-ink-strong';
      b.textContent = `${flagEmoji(code)} ${name}`;
      li.append(b);
      list.append(li);
    }
    list.addEventListener('click', (e) => {
      const code = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-code]')?.dataset
        .code;
      if (!code) return;
      storage.set(PICK_KEY, code);
      show();
      close();
      location.assign(link.href);
    });
    auto.addEventListener('click', () => {
      storage.set(PICK_KEY, null);
      show();
      close();
      if (detected === undefined) void detect();
    });

    const open = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      list
        .querySelector<HTMLButtonElement>('[aria-pressed="true"]')
        ?.scrollIntoView({ block: 'nearest' });
    };
    toggle.addEventListener('click', () => (menu.hidden ? open() : close()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !(e.target as Element).closest('[data-edition-root]')) close();
    });

    toggle.hidden = false;
    show();
    // Ask only when there is no manual pick and no fresh cached answer.
    if (!storage.get(PICK_KEY) && detected === undefined) void detect();
  }
</script>
