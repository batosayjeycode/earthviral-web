---
import { getCountries } from '../../lib/data.ts';
import { CATEGORIES } from '../../lib/taxonomy.ts';

// Countries with a hub page, for the edition button's geo swap: code → [slug, name].
const editions = Object.fromEntries(
  (await getCountries()).map((c) => [c.code, [c.slug, c.name]] as const),
);
---

<header class="glass border-x-0 border-t-0">
  <nav aria-label="Primary" class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-white"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-6 text-cyan"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
        <path d="M3 12h18"></path>
        <circle cx="17" cy="7" r="1.6" fill="currentColor" stroke="none"></circle>
      </svg>
      Earth<span class="text-cyan">Viral</span>
    </a>

    <ul class="ml-4 hidden items-center gap-1 text-sm text-ink-muted md:flex">
      <li>
        <a class="rounded-md px-3 py-2 hover:bg-white/5 hover:text-white" href="/#map">
          Explore Map
        </a>
      </li>
      <li>
        <a class="rounded-md px-3 py-2 hover:bg-white/5 hover:text-white" href="/#trending">
          Trending
        </a>
      </li>
      <li>
        <details class="group relative">
          <summary class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 hover:bg-white/5 hover:text-white [&::-webkit-details-marker]:hidden">
            Categories
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              class="size-4 transition group-open:rotate-180"
              fill="currentColor"
            >
              <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path>
            </svg>
          </summary>
          <ul class="glass absolute top-full left-0 mt-2 grid w-64 gap-0.5 rounded-xl p-2 shadow-2xl">
            {CATEGORIES.map((c) => (
              <li>
                <a
                  class="block rounded-md px-3 py-2 hover:bg-white/5 hover:text-white"
                  href={`/category/${c.slug}/`}
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <!-- Opens the Pagefind dialog when JS is ready; plain link to /search/ otherwise. -->
      <a
        href="/search/"
        data-search-trigger
        aria-keyshortcuts="Meta+K Control+K"
        class="flex items-center gap-2 rounded-lg border border-line px-2.5 py-1.5 text-sm text-ink-muted hover:border-cyan/40 hover:text-white sm:px-3"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="9" cy="9" r="6"></circle>
          <path d="m14 14 4 4"></path>
        </svg>
        <span class="sr-only sm:not-sr-only">Search</span>
        <kbd class="tabular hidden rounded border border-line px-1 text-xs sm:inline">⌘K</kbd>
      </a>
      <!-- Indonesia in the HTML (what crawlers and no-JS visitors get); the script below swaps
           in the visitor's country when it has a page. -->
      <a
        href="/country/indonesia/"
        data-edition
        data-editions={JSON.stringify(editions)}
        class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-sm text-ink hover:border-cyan/40"
        aria-label="Indonesia edition"
      >
        <span aria-hidden="true" data-edition-flag>
          🇮🇩
        </span>
        <span class="hidden sm:inline" data-edition-name>
          Indonesia
        </span>
      </a>
    </div>
  </nav>
</header>

<script>
  import { flagEmoji } from '../../lib/taxonomy.ts';

  // Visitor country from /api/geo (a Cloudflare Pages Function), remembered for a day so
  // later pages switch before first paint of the button and the Function runs ~once a day
  // per visitor. Failures (local preview, offline) leave the Indonesia default.
  const KEY = 'ev-geo';
  const DAY = 86_400_000;
  const link = document.querySelector<HTMLAnchorElement>('[data-edition]');

  function apply(code: string | null) {
    if (!link || !code) return;
    const editions = JSON.parse(link.dataset.editions ?? '{}') as Record<string, [string, string]>;
    const edition = editions[code];
    if (!edition) return;
    const [slug, name] = edition;
    link.href = `/country/${slug}/`;
    link.setAttribute('aria-label', `${name} edition`);
    link.querySelector('[data-edition-flag]')!.textContent = flagEmoji(code);
    link.querySelector('[data-edition-name]')!.textContent = name;
  }

  function cached(): { country: string | null } | null {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) ?? 'null');
      return v && Date.now() - v.at < DAY ? v : null;
    } catch {
      return null;
    }
  }

  const hit = cached();
  if (hit) apply(hit.country);
  else if (link) {
    fetch('/api/geo')
      .then((r) => (r.ok ? r.json() : null))
      .then((d: { country: string | null } | null) => {
        if (!d) return;
        try {
          localStorage.setItem(KEY, JSON.stringify({ country: d.country, at: Date.now() }));
        } catch {
          /* storage blocked: just refetch next time */
        }
        apply(d.country);
      })
      .catch(() => {});
  }
</script>
