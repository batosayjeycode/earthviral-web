{
  "name": "earthviral-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/**/*.test.ts tests/*.test.mjs",
    "test:unit": "node --test scripts/**/*.test.ts",
    "test:dist": "node --test tests/*.test.mjs",
    "qa": "node scripts/qa-browser.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "seed": "node scripts/seed/generate-seed-data.ts",
    "update:viral": "node --env-file-if-exists=.env scripts/generate-viral-batch.ts",
    "generate:viral": "node --env-file-if-exists=.env scripts/generate-viral-batch.ts",
    "indexnow": "node --env-file-if-exists=.env scripts/indexnow.ts",
    "geo:sync": "node scripts/sync-geo.ts",
    "predev": "node scripts/sync-geo.ts",
    "prebuild": "node scripts/sync-geo.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.6",
    "d3-geo": "^3.1.2",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.12.0",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
