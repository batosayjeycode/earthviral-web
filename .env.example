# Copy to .env for local batch runs (`npm run update:viral` loads it automatically).
# Without either key the batch still runs, with non-AI summaries.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite   # check the current model list in AI Studio
OPENAI_API_KEY=
# Stories kept per country (default 10; 0 = no cap). Lower-ranked stories redirect to the country page.
# MAX_STORIES_PER_COUNTRY=10
# Parallel AI calls (default 2). Keep low on free tiers, which rate-limit per minute.
# AI_CONCURRENCY=2
# OPENAI_MODEL=gpt-5-mini   # covered by OpenAI's free daily tokens when data sharing is on

# Site build (GitHub → Settings → Secrets and variables → Actions: variables, INDEXNOW_KEY as a secret). All optional.
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# PUBLIC_ADSENSE_SLOT_STORY=
# PUBLIC_ADSENSE_SLOT_HUB=
# PUBLIC_CONTACT_EMAIL=
# INDEXNOW_KEY=   # 8–128 chars [a-zA-Z0-9-]
