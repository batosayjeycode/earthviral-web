# Copy to .env for local batch runs (`npm run update:viral` loads it automatically).
# Without either key the batch still runs, with non-AI summaries.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Site build (GitHub → Settings → Secrets and variables → Actions: variables, INDEXNOW_KEY as a secret). All optional.
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# PUBLIC_ADSENSE_SLOT_STORY=
# PUBLIC_ADSENSE_SLOT_HUB=
# PUBLIC_CONTACT_EMAIL=
# INDEXNOW_KEY=   # 8–128 chars [a-zA-Z0-9-]
